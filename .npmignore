# `files` in package.json is the authoritative allow-list; these rules prune anything that could
# slip into an allow-listed directory.

# Build artifacts inside android/ and ios/
android/build/
android/.gradle/
android/.kotlin/
ios/build/
ios/Pods/
ios/DerivedData/
ios/*.xcresult
ios/.build/

# Security
.npmrc
.env
.env*.local

# Logs, dumps and OS files
*.log
*.stackdump
.DS_Store
Thumbs.db
