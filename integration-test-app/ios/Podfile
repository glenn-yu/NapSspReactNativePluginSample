require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

platform :ios, '14.0'
prepare_react_native_project!

target 'IntegrationTestApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # pod 'NapSspPlugin/Core', :path => './NapSspLocalPod'
  # pod 'NapSspPlugin/AdFit', :path => './NapSspLocalPod'

  # Nap SSP SDK 의존성 추가
  pod 'AdFitSDK', '>= 3.14.7', '<= 3.18.6'
  pod 'AdMixerMediation'
  # pod 'AdMixerMediationGAM'  # disabled for simulator Maestro smoke tests, requires GMA publisher init metadata
  pod 'AdMixerMediationAdFit'

  target 'IntegrationTestAppTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        flags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        extra = ' -Wno-error=deprecated-literal-operator -Wno-deprecated-literal-operator'
        unless flags.include?('-Wno-error=deprecated-literal-operator')
          build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = flags + extra
        end

        if target.name == 'RCT-Folly'
          defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defs = [defs] unless defs.is_a?(Array)
          defs << 'FOLLY_HAVE_CLOCK_GETTIME=1' unless defs.include?('FOLLY_HAVE_CLOCK_GETTIME=1')
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
        end
      end
    end
  end
end
