{
  "name": "react-native-nap-ssp",
  "version": "0.1.2",
  "description": "React Native plugin for KT Nasmedia nap ssp SDK",
  "author": "gwangy",
  "license": "MIT",
  "homepage": "https://github.com/glenn-yu/react-native-nap-ssp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glenn-yu/react-native-nap-ssp.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "android",
    "ios",
    "README.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md"
  ],
  "jest": {
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('lib')) fs.rmSync('lib', { recursive: true, force: true })\"",
    "lint": "npm run typecheck",
    "test": "npm run typecheck && npm run smoke:test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:test": "node scripts/smoke-test.js",
    "verify": "npm run typecheck && npm run build && npm run smoke:test",
    "start:example": "npm --prefix example start"
  },
  "react-native": {
    "android": {
      "sourceDir": "./android"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-native": "^0.72.8",
    "react": "^19.2.5",
    "react-native": "^0.72.17",
    "typescript": "^5.5.4"
  }
}
