{
  "name": "react-native-nap-ssp",
  "version": "0.1.5",
  "description": "React Native plugin for KT Nasmedia nap ssp SDK",
  "author": "gwangy",
  "license": "MIT",
  "homepage": "https://gwangy.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glenn-yu/NapSspReactNativePluginSample.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "android/src",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "ios",
    "docs/GETTING_STARTED.md",
    "docs/API_REFERENCE.md",
    "docs/ANDROID_SETUP.md",
    "docs/IOS_SETUP.md",
    "docs/MEDIATION_GUIDE.md",
    "docs/SPM_GUIDE.md",
    "docs/MIGRATION_GUIDE.md",
    "docs/VERSION_MATRIX.md",
    "docs/TROUBLESHOOTING.md",
    "docs/FAQ.md",
    "docs/ADVANCED_USAGE.md",
    "docs/NATIVE_ASSETS_GUIDE.md",
    "docs/PRIVACY_GUIDE.md",
    "docs/EXPO_GUIDE.md",
    "docs/GLOSSARY.md",
    "docs/ROADMAP.md",
    "NapSspPlugin.podspec",
    "README.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md"
  ],
  "jest": {
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('lib')) fs.rmSync('lib', { recursive: true, force: true })\"",
    "lint": "npm run typecheck",
    "test": "npm run typecheck && npm run smoke:test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:test": "node scripts/smoke-test.js",
    "verify": "npm run typecheck && npm run build && npm run smoke:test",
    "start:example": "npm --prefix example start"
  },
  "react-native": {
    "android": {
      "sourceDir": "./android"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0", 
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-native": "^0.72.8",
    "react": "^18.2.0",
    "react-native": "^0.72.17",
    "typescript": "^5.5.4"
  }
}
