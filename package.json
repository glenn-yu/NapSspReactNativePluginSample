{
  "name": "react-native-nap-ssp",
  "version": "0.5.0",
  "description": "React Native plugin for the nap mx (KT Nasmedia AdMixer SSP) ad SDK — banner, native, video, interstitial, interstitial video and rewarded formats",
  "author": "gwangy",
  "license": "MIT",
  "homepage": "https://gwangy.com",
  "keywords": [
    "react-native",
    "ios",
    "android",
    "ads",
    "advertising",
    "monetization",
    "mediation",
    "nap-mx",
    "admixer",
    "nasmedia",
    "ssp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glenn-yu/NapSspReactNativePluginSample.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "android/src",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "ios",
    "docs",
    "NapSspPlugin.podspec",
    "react-native.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('lib')) fs.rmSync('lib', { recursive: true, force: true })\"",
    "lint": "npm run typecheck",
    "test": "npm run typecheck && npm run smoke:test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:test": "node scripts/smoke-test.js",
    "verify": "npm run clean && npm run typecheck && npm run build && npm run smoke:test",
    "start:example": "npm --prefix example start"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "react": "^18.2.0",
    "react-native": "^0.79.7",
    "typescript": "^5.5.4"
  }
}
